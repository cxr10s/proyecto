    <Component class="javax.swing.JComboBox" name="CobAlimento">
      <Properties>
        <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
          <Font name="Times New Roman" size="15" style="0"/>
        </Property>
        <Property name="model" type="javax.swing.ComboBoxModel" editor="org.netbeans.modules.form.editors2.ComboBoxModelEditor">
          <StringArray count="25">
            <StringItem index="0" value="Pan, arepas, bollos y almoj&#xe1;banas"/>
            <StringItem index="1" value="Galletas de sal y de dulce"/>
            <StringItem index="2" value="Arroz, pastas alimenticias, avena, ma&#xed;z, harinas y otros cereales (para el desayuno)"/>
            <StringItem index="3" value="Carne de res, cerdo, hueso y v&#xed;sceras"/>
            <StringItem index="4" value="Pollo, otras aves y menudencias"/>
            <StringItem index="5" value="Salchichas, jam&#xf3;n, mortadela, salchich&#xf3;n y otras carnes fr&#xed;as preparadas (incluidos los embutidos vegetarianos)"/>
            <StringItem index="6" value="Pescado de r&#xed;o, mar y otros productos marinos (frescos, congelados y enlatados)"/>
            <StringItem index="7" value="Leche (animal y vegetal)"/>
            <StringItem index="8" value="Queso (animal y vegetal)"/>
            <StringItem index="9" value="Otros derivados de la leche: yogur, kumis, etc."/>
            <StringItem index="10" value="Huevos"/>
            <StringItem index="11" value="Aceites y grasas: aceite, manteca, mantequilla, margarina, etc."/>
            <StringItem index="12" value="Frutas"/>
            <StringItem index="13" value="Verduras y hortalizas: tomate, cebolla, arveja, espinaca, apio, zanahoria, etc."/>
            <StringItem index="14" value="Granos secos: fr&#xed;jol, lenteja, garbanzo, etc."/>
            <StringItem index="15" value="Enlatados y encurtidos: arveja, fr&#xed;jol, ma&#xed;z, esp&#xe1;rragos, zanahoria, habichuela, etc."/>
            <StringItem index="16" value="Pl&#xe1;tano, yuca, arracacha, &#xf1;ame, papa y otros tub&#xe9;rculos"/>
            <StringItem index="17" value="Az&#xfa;car, panela y otros endulzantes"/>
            <StringItem index="18" value="Mermeladas, arequipe, bocadillos, compotas, dulces, helados, chocolatinas, ponquecitos, etc."/>
            <StringItem index="19" value="Salsas, mayonesa, mostaza, vinagre, etc."/>
            <StringItem index="20" value="Sal y condimentos"/>
            <StringItem index="21" value="Caf&#xe9;, chocolate, otras bebidas con cacao (milo, chocolisto), t&#xe9; y hierbas arom&#xe1;ticas"/>
            <StringItem index="22" value="Papas fritas, chitos, maicitos, patacones, besitos, man&#xed;, etc."/>
            <StringItem index="23" value="Agua, gaseosas, refrescos, jugos, t&#xe9; fr&#xed;o y otras bebidas no alcoh&#xf3;licas"/>
            <StringItem index="24" value="Alimentos y bebidas preparados fuera, del hogar, para consumir dentro o fuera, del hogar"/>
          </StringArray>
        </Property>
      </Properties>
